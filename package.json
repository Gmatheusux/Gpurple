{
  "name": "gpurple-site",
  "private": true,
  "description": "Site portfólio da GPurple Studio",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify && tailwindcss -c tailwind.templates.config.js -i ./src/tailwind.css -o ./assets/css/templates-email.css --minify",
    "dev": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/container-queries": "0.1.1"
  }
}
